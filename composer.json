{
    "name": "eclipxe/php-soft-daemon",
    "description": "PHP Library to wait for system signals and running code",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Carlos C Soto",
            "email": "eclipxe13@gmail.com",
            "homepage": "https://eclipxe.com.mx/"
        }
    ],
    "homepage": "https://github.com/eclipxe13/php-soft-daemon",
    "support": {
        "issues": "https://github.com/eclipxe13/php-soft-daemon/issues",
        "source": "https://github.com/eclipxe13/php-soft-daemon"
    },
    "require": {
        "php": ">=8.2",
        "ext-pcntl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.55"
    },
    "autoload": {
        "psr-4": {
            "Eclipxe\\SoftDaemon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eclipxe\\SoftDaemon\\Examples\\": "examples/",
            "Eclipxe\\SoftDaemon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev:build": [
            "@dev:fix-style",
            "@dev:test"
        ],
        "dev:check-style": [
            "@php tools/composer-normalize normalize --dry-run",
            "@php tools/php-cs-fixer fix --dry-run --verbose",
            "@php tools/phpcs --colors -sp"
        ],
        "dev:coverage": [
            "@php -dzend_extension=xdebug.so -dxdebug.mode=coverage vendor/bin/phpunit --coverage-html build/coverage/html/"
        ],
        "dev:fix-style": [
            "@php tools/composer-normalize normalize",
            "@php tools/php-cs-fixer fix --verbose",
            "@php tools/phpcbf --colors -sp"
        ],
        "dev:infection": [
            "@php tools/infection --initial-tests-php-options='-dzend_extension=xdebug.so -dxdebug.mode=coverage' --show-mutations --no-progress"
        ],
        "dev:test": [
            "@dev:check-style",
            "@php vendor/bin/phpunit --testdox --stop-on-failure",
            "@php tools/phpstan analyse --no-progress",
            "@dev:infection"
        ]
    },
    "scripts-descriptions": {
        "dev:build": "DEV: run dev:fix-style and dev:tests, run before pull request",
        "dev:check-style": "DEV: search for code style errors using composer-normalize, php-cs-fixer and phpcs",
        "dev:coverage": "DEV: run phpunit with xdebug and storage coverage in build/coverage/html/",
        "dev:fix-style": "DEV: fix code style errors using composer-normalize, php-cs-fixer and phpcbf",
        "dev:infection": "DEV: run mutation tests using infection",
        "dev:test": "DEV: run dev:check-style, phpunit, phpstan and infection"
    }
}
